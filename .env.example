# Environment Variables for Rycarix E-Commerce Platform
# Database Configuration (PostgreSQL with Supabase / Neon / AWS RDS)
DATABASE_URL="postgresql://postgres:password@localhost:5432/rycarix_db?schema=public"

# Next.js Application URL
NEXT_PUBLIC_APP_URL="https://www.rycarix.com"

# Stripe & Klarna Integration
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Klarna Direct Merchant API (If using Klarna direct rather than Stripe)
KLARNA_MERCHANT_ID="K123456"
KLARNA_SHARED_SECRET="shared_secret_..."
KLARNA_API_ENDPOINT="https://api.playground.klarna.com"

# NextAuth / Auth.js Configuration
NEXTAUTH_SECRET="super-secret-crypto-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Admin Access Protection
ADMIN_SECRET_TOKEN="rycarix-atelier-key-2026"
